{
  "name": "vaultwarden-drop-slot-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.ip2k/vaultwarden-drop-slot-mcp",
  "description": "MCP server, CLI and Node.js module for create-only, age-encrypted credential deposits into self-hosted Vaultwarden: AI agents and scripts save new passwords and secure notes without vault read access.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "bin": {
    "vaultwarden-drop-slot-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ip2k/vaultwarden-drop-slot-mcp.git"
  },
  "homepage": "https://github.com/ip2k/vaultwarden-drop-slot-mcp#readme",
  "bugs": {
    "url": "https://github.com/ip2k/vaultwarden-drop-slot-mcp/issues"
  },
  "keywords": [
    "vaultwarden",
    "bitwarden",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "password-manager",
    "secrets",
    "secrets-management",
    "credentials",
    "password",
    "write-only",
    "create-only",
    "age",
    "age-encryption",
    "encryption",
    "self-hosted",
    "ai-agent",
    "claude-code",
    "codex",
    "devops"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "age-encryption": "0.3.1",
    "express": "5.2.1",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
