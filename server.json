{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ip2k/vaultwarden-drop-slot-mcp",
  "title": "Vaultwarden Drop Slot",
  "description": "Create-only, age-encrypted deposits of new logins and notes into Vaultwarden, without vault reads.",
  "version": "0.1.0",
  "websiteUrl": "https://github.com/ip2k/vaultwarden-drop-slot-mcp#readme",
  "repository": {
    "url": "https://github.com/ip2k/vaultwarden-drop-slot-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "vaultwarden-drop-slot-mcp",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "stdio"
        },
        {
          "type": "positional",
          "valueHint": "client_config",
          "description": "Absolute path to the private producer client.json created during enrollment (see docs/SETUP.md).",
          "isRequired": true,
          "format": "filepath"
        }
      ]
    }
  ]
}
