{
  "tools": [
    {
      "name": "deposit_secret",
      "description": "Encrypt and queue a new login or secure note in the administrator-selected Vaultwarden destination. Returns an opaque receipt only. Reusing request_id retries the original item; changed arguments do not overwrite it.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Fresh UUID for a new item; reuse the same UUID only to retry the original deposit."
          },
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "notes": {
                    "default": "",
                    "type": "string",
                    "maxLength": 32768
                  },
                  "fields": {
                    "default": [],
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "value": {
                          "type": "string",
                          "maxLength": 4096
                        },
                        "hidden": {
                          "default": true,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "type": {
                    "type": "string",
                    "const": "login"
                  },
                  "username": {
                    "default": "",
                    "type": "string",
                    "maxLength": 1024
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "urls": {
                    "default": [],
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 2048
                    }
                  }
                },
                "required": [
                  "name",
                  "type",
                  "password"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "notes": {
                    "default": "",
                    "type": "string",
                    "maxLength": 32768
                  },
                  "fields": {
                    "default": [],
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "value": {
                          "type": "string",
                          "maxLength": 4096
                        },
                        "hidden": {
                          "default": true,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "type": {
                    "type": "string",
                    "const": "secure_note"
                  }
                },
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false
              }
            ],
            "description": "New login or secure note. Do not include routing or vault identifiers.",
            "type": "object"
          }
        },
        "required": [
          "request_id",
          "payload"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "deposit_status",
      "description": "Read only the delivery state of your own opaque deposit receipt. Never returns names, contents, vault IDs, or search results.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "receipt": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Opaque receipt previously issued to this writer."
          }
        },
        "required": [
          "receipt"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
