{
  "openapi": "3.1.0",
  "info": {
    "title": "Vaultwarden Drop Slot Inbox",
    "version": "1.0.0",
    "description": "Authenticated, create-only encrypted deposits. No vault read, search, edit, or delete operations. Recipients are pinned during enrollment; fetching a key never authorizes its replacement. JSON bodies are at most 256 KiB. Errors never include submitted values.",
    "contact": {
      "name": "Project maintainers",
      "url": "https://github.com/ip2k/vaultwarden-drop-slot-mcp/issues"
    },
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "https://drop-slot.example.com",
      "description": "Your administrator-owned HTTPS inbox"
    }
  ],
  "security": [
    {
      "WriterToken": []
    }
  ],
  "tags": [
    {
      "name": "Deposits",
      "description": "Write-only envelope and receipt API"
    }
  ],
  "paths": {
    "/v1/recipient": {
      "get": {
        "operationId": "getRecipient",
        "summary": "Get the current public recipient",
        "description": "Authenticated enrollment helper. Verify its fingerprint independently; never automatically trust a fetched replacement.",
        "tags": [
          "Deposits"
        ],
        "responses": {
          "200": {
            "description": "Current public encryption recipient",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipient"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unknown encryption key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or revoked writer credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer authentication challenge",
                "schema": {
                  "type": "string",
                  "example": "Bearer"
                }
              }
            }
          },
          "404": {
            "description": "Not found, including another writer’s receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure; no sensitive details returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/deposits": {
      "post": {
        "operationId": "submitDeposit",
        "summary": "Queue an encrypted envelope",
        "description": "Requires a writer credential. Idempotency is scoped to writer and request_id; exact envelope replay returns the original receipt. Changed ciphertext returns 409. Public request_id and key_id use the protocol’s snake_case naming deliberately.",
        "tags": [
          "Deposits"
        ],
        "requestBody": {
          "required": true,
          "description": "An age X25519 envelope; payload is never plaintext here",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Envelope"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted or an exact replay of a prior request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unknown encryption key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or revoked writer credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer authentication challenge",
                "schema": {
                  "type": "string",
                  "example": "Bearer"
                }
              }
            }
          },
          "404": {
            "description": "Not found, including another writer’s receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request ID already bound to another encrypted envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Bounded input size exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Writer or installation quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Minimum seconds before another attempt; daily/pending limits may require a longer wait",
                "schema": {
                  "type": "string",
                  "example": "60"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure; no sensitive details returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/receipts/{receipt}": {
      "get": {
        "operationId": "getDepositStatus",
        "summary": "Get your own deposit state",
        "description": "Only queued, importing, imported, or failed. A foreign receipt is indistinguishable from an unknown receipt.",
        "tags": [
          "Deposits"
        ],
        "parameters": [
          {
            "name": "receipt",
            "in": "path",
            "required": true,
            "description": "Opaque receipt issued to this writer",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Own delivery state only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unknown encryption key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or revoked writer credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer authentication challenge",
                "schema": {
                  "type": "string",
                  "example": "Bearer"
                }
              }
            }
          },
          "404": {
            "description": "Not found, including another writer’s receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure; no sensitive details returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "WriterToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-writer random 256-bit token, stored hashed in the inbox"
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          },
          "key_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "ciphertext": {
            "type": "string",
            "minLength": 100,
            "maxLength": 180000,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "required": [
          "version",
          "key_id",
          "request_id",
          "ciphertext"
        ],
        "additionalProperties": false
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "receipt": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "importing",
              "imported",
              "failed"
            ]
          }
        },
        "required": [
          "receipt",
          "state"
        ],
        "additionalProperties": false,
        "example": {
          "receipt": "01234567-89ab-4def-8123-456789abcdef",
          "state": "queued"
        }
      },
      "Recipient": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "recipient",
          "key_id"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "recipient": {
            "type": "string",
            "description": "age X25519 public recipient"
          },
          "key_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of the exact ASCII recipient"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable, non-sensitive error code"
              }
            }
          }
        }
      },
      "EncryptedDocument": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          },
          "writer_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "notes": {
                    "default": "",
                    "type": "string",
                    "maxLength": 32768
                  },
                  "fields": {
                    "default": [],
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "value": {
                          "type": "string",
                          "maxLength": 4096
                        },
                        "hidden": {
                          "default": true,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "type": {
                    "type": "string",
                    "const": "login"
                  },
                  "username": {
                    "default": "",
                    "type": "string",
                    "maxLength": 1024
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "urls": {
                    "default": [],
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 2048
                    }
                  }
                },
                "required": [
                  "name",
                  "type",
                  "password"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "notes": {
                    "default": "",
                    "type": "string",
                    "maxLength": 32768
                  },
                  "fields": {
                    "default": [],
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "value": {
                          "type": "string",
                          "maxLength": 4096
                        },
                        "hidden": {
                          "default": true,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "type": {
                    "type": "string",
                    "const": "secure_note"
                  }
                },
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "version",
          "writer_id",
          "request_id",
          "payload"
        ],
        "additionalProperties": false
      },
      "Payload": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "notes": {
                "default": "",
                "type": "string",
                "maxLength": 32768
              },
              "fields": {
                "default": [],
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "hidden": {
                      "default": true,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "type": {
                "type": "string",
                "const": "login"
              },
              "username": {
                "default": "",
                "type": "string",
                "maxLength": 1024
              },
              "password": {
                "type": "string",
                "maxLength": 8192
              },
              "urls": {
                "default": [],
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            },
            "required": [
              "name",
              "type",
              "password"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "notes": {
                "default": "",
                "type": "string",
                "maxLength": 32768
              },
              "fields": {
                "default": [],
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "hidden": {
                      "default": true,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "type": {
                "type": "string",
                "const": "secure_note"
              }
            },
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "x-mcp-tools": [
    {
      "name": "deposit_secret",
      "description": "Encrypt and queue a new login or secure note in the administrator-selected Vaultwarden destination. Returns an opaque receipt only. Reusing request_id retries the original item; changed arguments do not overwrite it.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Fresh UUID for a new item; reuse the same UUID only to retry the original deposit."
          },
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "notes": {
                    "default": "",
                    "type": "string",
                    "maxLength": 32768
                  },
                  "fields": {
                    "default": [],
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "value": {
                          "type": "string",
                          "maxLength": 4096
                        },
                        "hidden": {
                          "default": true,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "type": {
                    "type": "string",
                    "const": "login"
                  },
                  "username": {
                    "default": "",
                    "type": "string",
                    "maxLength": 1024
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "urls": {
                    "default": [],
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 2048
                    }
                  }
                },
                "required": [
                  "name",
                  "type",
                  "password"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "notes": {
                    "default": "",
                    "type": "string",
                    "maxLength": 32768
                  },
                  "fields": {
                    "default": [],
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "value": {
                          "type": "string",
                          "maxLength": 4096
                        },
                        "hidden": {
                          "default": true,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "type": {
                    "type": "string",
                    "const": "secure_note"
                  }
                },
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false
              }
            ],
            "description": "New login or secure note. Do not include routing or vault identifiers.",
            "type": "object"
          }
        },
        "required": [
          "request_id",
          "payload"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "deposit_status",
      "description": "Read only the delivery state of your own opaque deposit receipt. Never returns names, contents, vault IDs, or search results.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "receipt": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Opaque receipt previously issued to this writer."
          }
        },
        "required": [
          "receipt"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
